{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python *)",
      "Bash(ln -s *)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(grep *)",
      "Bash(cut *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(git merge --ff-only *)",
      "Edit(notes/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/commit-note.sh",
            "timeout": 60,
            "statusMessage": "노트 커밋·푸시"
          }
        ]
      }
    ]
  }
}
